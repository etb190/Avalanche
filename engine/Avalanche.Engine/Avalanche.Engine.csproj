<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Avalanche.Engine</RootNamespace>
    <AssemblyName>Avalanche.Engine</AssemblyName>
    <Version>1.19.2</Version>
    <PackageId>Avalanche.Engine</PackageId>
    <Title>The Avalanche.Engine</Title>
    <Authors>Avalanche Team</Authors>
    <Copyright>Copyright (c) 2026 Avalanche Team</Copyright>
    <Description>An independent .NET PDF 2.0 document engine for reading, validating, authoring, editing, signing, encrypting, and writing PDF files.</Description>
    <PackageTags>pdf;pdf-2.0;pdf-a;pdf-ua;validation;authoring;signing;encryption;document-processing;csharp</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://avalanche.net/engine.html</PackageProjectUrl>
    <RepositoryUrl>https://github.com/etb190/Avalanche</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/etb190/Avalanche/blob/main/engine/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="VerifyAppEngineVersion" BeforeTargets="PrepareForBuild;GenerateNuspec">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../../Avalanche.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="AvalancheAppVersion" />
    </XmlPeek>
    <Error Condition="'$(Version)' != '$(AvalancheAppVersion)'" Text="Engine version $(Version) must match app version $(AvalancheAppVersion). Update both before building or packaging." />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
