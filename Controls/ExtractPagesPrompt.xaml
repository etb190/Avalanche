<!-- Controls/ExtractPagesPrompt.xaml - the Extract Pages prompt's body.
     The chrome (rounded card, themed title bar, close chip, pop entrance,
     Escape-close) is composed in code-behind from DialogChrome, exactly like
     the recap companion's. The window is the container and is deliberately
     empty of everything but the ask: the code-behind builds the label, the
     input, the hint, the error line and the button row from the shared UiKit
     faces, so this file only carries the recap-flavored resources. -->
<Window x:Class="Avalanche.ExtractPagesPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <!-- The close chip: the recap's own family face - danger red mark at
             rest, red face with the on-primary mark on hover - so the
             prompt's close mark reads as the same species inside the same
             chrome. (Window-scoped, like every shared face here.) -->
        <Style x:Key="ExtractCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="BodyRoot"/>
</Window>
