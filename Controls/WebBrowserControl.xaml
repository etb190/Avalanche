<UserControl x:Class="Avalanche.Controls.WebBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!-- The lightweight in-app browser (v1.19.0): navigation chrome, an omnibox that
         searches when the text is not an address, a row of curated academic quick-access
         chips, and one WebView2 host. Chromium never ships in the payload - Windows'
         Evergreen runtime is the engine, so this control is a few KB of chrome around
         one managed wrapper, created lazily and suspended whenever its pane hides. -->
    <UserControl.Resources>
        <Style x:Key="WebNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WebDialChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation row: the four browser keys, the omnibox, and the hand-off button -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarPaneBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="WebBackBtn" Content="&#xE72B;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebBackBtn_Click" ToolTip="{DynamicResource Str_TT_WebBack}"/>
                <Button x:Name="WebForwardBtn" Content="&#xE72A;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebForwardBtn_Click" ToolTip="{DynamicResource Str_TT_WebForward}"/>
                <Button x:Name="WebRefreshBtn" Content="&#xE72C;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebRefreshBtn_Click" ToolTip="{DynamicResource Str_TT_WebRefresh}"/>
                <Button x:Name="WebHomeBtn" Content="&#xE80F;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebHomeBtn_Click" ToolTip="{DynamicResource Str_TT_WebHome}"/>
                <Border Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="28" Width="340" Margin="6,0">
                    <Grid>
                        <TextBlock x:Name="OmniHint" Text="{DynamicResource Str_Web_OmniHint}"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False"/>
                        <TextBox x:Name="OmniBox" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 BorderThickness="0" CaretBrush="{DynamicResource PrimaryBrush}"
                                 SelectionBrush="{DynamicResource RowSelectedBrush}" VerticalContentAlignment="Center"
                                 Margin="8,0" FontSize="12"
                                 KeyDown="OmniBox_KeyDown" TextChanged="OmniBox_TextChanged"/>
                    </Grid>
                </Border>
                <Button x:Name="WebOpenPdfBtn" Content="&#xE8A7;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebOpenPdfBtn_Click" ToolTip="{DynamicResource Str_TT_WebOpenPdf}"/>
            </StackPanel>
        </Border>

        <!-- Quick access: the curated academic hubs from the browser brief -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,7,10,2">
            <Button Style="{StaticResource WebDialChip}" Tag="https://archive.org/" Click="DialChip_Click" Content="Internet Archive"/>
            <Button Style="{StaticResource WebDialChip}" Tag="https://scholar.google.com/" Click="DialChip_Click" Content="Google Scholar"/>
            <Button Style="{StaticResource WebDialChip}" Tag="https://www.gutenberg.org/" Click="DialChip_Click" Content="Project Gutenberg"/>
            <Button Style="{StaticResource WebDialChip}" Tag="https://arxiv.org/" Click="DialChip_Click" Content="arXiv"/>
            <Button Style="{StaticResource WebDialChip}" Tag="https://pubmed.ncbi.nlm.nih.gov/" Click="DialChip_Click" Content="PubMed"/>
        </StackPanel>

        <!-- Status strip: PDF hand-off progress here (never over the webview - a live
             WebView2 is a native hwnd and would cover any WPF overlay), and the
             runtime-missing message once it is the only thing left to say. -->
        <TextBlock x:Name="WebStatus" Grid.Row="2" Visibility="Collapsed" Margin="12,4,12,2"
                   FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"
                   TextTrimming="CharacterEllipsis"/>

        <!-- The engine -->
        <Border Grid.Row="3" Margin="8,4,8,8" Background="{DynamicResource PaneBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>
    </Grid>
</UserControl>
