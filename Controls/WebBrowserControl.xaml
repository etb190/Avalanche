<UserControl x:Class="Avalanche.Controls.WebBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The lightweight in-app browser (v1.19.0): navigation chrome, an omnibox that
         searches when the text is not an address, the reader's own bookmark chips
         (v1.19.11 - the curated dial chips retired), and one WebView2 host. Chromium
         never ships in the payload - Windows' Evergreen runtime is the engine, so this
         control is a few KB of chrome around one managed wrapper, created lazily and
         suspended whenever its pane hides. -->
    <UserControl.Resources>
        <Style x:Key="WebNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WebBookmarkChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation row: the four browser keys, the omnibox, and the hand-off button -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarPaneBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="WebBackBtn" Content="&#xE72B;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebBackBtn_Click" ToolTip="{DynamicResource Str_TT_WebBack}"/>
                <Button x:Name="WebForwardBtn" Content="&#xE72A;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebForwardBtn_Click" ToolTip="{DynamicResource Str_TT_WebForward}"/>
                <Button x:Name="WebRefreshBtn" Content="&#xE72C;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebRefreshBtn_Click" ToolTip="{DynamicResource Str_TT_WebRefresh}"/>
                <Button x:Name="WebHomeBtn" Content="&#xE80F;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebHomeBtn_Click" ToolTip="{DynamicResource Str_TT_WebHome}"/>
                <Border Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="28" Width="340" Margin="6,0">
                    <Grid>
                        <TextBlock x:Name="OmniHint" Text="{DynamicResource Str_Web_OmniHint}"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False"/>
                        <TextBox x:Name="OmniBox" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 BorderThickness="0" CaretBrush="{DynamicResource PrimaryBrush}"
                                 SelectionBrush="{DynamicResource RowSelectedBrush}" VerticalContentAlignment="Center"
                                 Margin="8,0" FontSize="12"
                                 KeyDown="OmniBox_KeyDown" TextChanged="OmniBox_TextChanged"
                                 PreviewMouseLeftButtonDown="OmniBox_PreviewMouseDown"/>
                    </Grid>
                </Border>
                <!-- v1.19.11: the hand-off's word became a light in the toolbar row.
                     A spinner turns while a document is being fetched, a green check
                     confirms the hand-off, a red cross reports a refusal - the glyph
                     only ever swaps itself, never the row's height, and the word it
                     used to speak rides the tooltip. -->
                <Grid x:Name="WebActivityIndicator" Width="24" Height="24" Margin="2,0"
                      Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                      ToolTipService.InitialShowDelay="0">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="WebActivitySpin" Angle="0"/>
                    </Grid.RenderTransform>
                    <TextBlock x:Name="WebActivityGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Border Width="1" Height="18" Background="{DynamicResource CardBorderBrush}" Margin="4,0"/>
                <!-- v1.19.11: the bookmark star - outlined while the page on screen is
                     not saved, filled once it lives in the reader's bookmarks. -->
                <Button x:Name="WebBookmarkBtn" Content="&#xE728;" Style="{StaticResource WebNavBtn}"
                        IsEnabled="False" Click="WebBookmarkBtn_Click" ToolTip="{DynamicResource Str_TT_WebBookmark}"/>
            </StackPanel>
        </Border>

        <!-- v1.19.11: the reader's own bookmarks, where the curated dial chips used
             to sit. One chip per saved page - a globe and the name the reader gave
             it; a click opens the page, a right-click offers Edit and Delete, and
             until the first page is saved a quiet hint points at the star. -->
        <Grid Grid.Row="1" Margin="10,7,10,2">
            <TextBlock x:Name="WebBookmarksHint" Text="{DynamicResource Str_Web_BookmarkHint}"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <ItemsControl x:Name="WebBookmarksList"
                          ItemsSource="{Binding Bookmarks, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource WebBookmarkChip}" Tag="{Binding Url}"
                                Click="BookmarkChip_Click" ToolTip="{Binding Url}"
                                ContextMenuOpening="BookmarkChip_ContextMenuOpening">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Margin="0,1,5,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str_Web_OpenInNewTab}" Click="BookmarkOpenInTab_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Edit}" Click="BookmarkEdit_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Ctx_BmDelete}" Click="BookmarkDelete_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- v1.19.11: this strip speaks only when there is no engine to dress the
             word in - the runtime-missing message. The hand-off's progress lives in
             the toolbar light, never over the webview (a live WebView2 is a native
             hwnd and would cover any WPF overlay), and never as a row that pushes
             the page down. -->
        <TextBlock x:Name="WebStatus" Grid.Row="2" Visibility="Collapsed" Margin="12,4,12,2"
                   FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"
                   TextTrimming="CharacterEllipsis"/>

        <!-- The engine. v1.19.13: the host carries one live view per tab - every
             card in the gallery owns its own WebView2 sharing the one profile, and
             switching tabs shows one view and collapses the rest. Nothing navigates
             on a switch, so a tab keeps its page, its scroll and its typing until
             the reader closes it. -->
        <Border Grid.Row="3" Margin="8,4,8,8" Background="{DynamicResource PaneBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid x:Name="BrowserHost"/>
        </Border>

        <!-- v1.19.11: the bookmark naming flyout - one field, one save. It names a
             new page (prefilled with the page's own title) or renames a saved one;
             the star flips its fill either way. Enter saves, Escape closes. -->
        <Popup x:Name="WebBookmarkPopup" PlacementTarget="{Binding ElementName=WebBookmarkBtn}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource WebFlyoutBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10" Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel MinWidth="240">
                    <TextBlock Text="{DynamicResource Str_Web_BookmarkName}" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="WebBookmarkNameBox" Background="{DynamicResource PaneBrush}"
                             Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                             BorderThickness="1" Padding="6,4" FontSize="12" CaretBrush="{DynamicResource PrimaryBrush}"
                             KeyDown="WebBookmarkNameBox_KeyDown"/>
                    <Button Content="{DynamicResource Str_Btn_Save}" Style="{StaticResource WebBookmarkChip}"
                            HorizontalAlignment="Right" Margin="0,8,0,0" Click="WebBookmarkSave_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
