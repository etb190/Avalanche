<UserControl x:Class="Avalanche.Controls.TextEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The lightweight text editor (v1.19.64): the document area's third face,
         next to the PDF editor and the browser. One ribbon of real editor
         controls - the mode switches the reader asked to see first, then font,
         size, bold / italic / underline / strikethrough, hyperlink, footnote
         and a behind-text image - and one WebView2 host running an embedded
         editor document: real Letter pages that grow on their own, text that
         flows onto a fresh page when a page is full, and images that live
         behind the text and move freely. Chromium never ships in the payload -
         the same Evergreen runtime the browser pane already rides - so this
         control is a few KB of chrome around one embedded HTML string. -->
    <UserControl.Resources>
        <Style x:Key="EditorBtn" TargetType="Button">
            <!-- Twice as large, the reader's own measure (v1.19.73): every
                 face on this ribbon doubles - buttons, glyphs and all. -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The format toggles share the button's face and add a checked state:
             the pressed face comes from the page's own report (the JS side is
             the single source of truth for what the caret is wearing). -->
        <Style x:Key="EditorToggle" TargetType="ToggleButton">
            <!-- The toggles share the button's doubled face (v1.19.73). -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorPopupItem" TargetType="ListBoxItem">
            <!-- The lists read at the ribbon's doubled size (v1.19.73). -->
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="face" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The face of the font / size dials: a wide flat chip carrying the
             current value and a drop caret, opening a themed popup list. -->
        <Style x:Key="EditorDial" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorPopupBorder" TargetType="Border">
            <!-- MenuBackgroundBrush, not MenuBrush: no theme ever defined
                 MenuBrush, and a DynamicResource that misses renders nothing -
                 the reader saw straight through both dials' dropdowns
                 (v1.19.67). -->
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The size dial's separate caret button (v1.19.68): the dial's own
             face, narrowed to a square - it opens the list, nothing more. -->
        <Style x:Key="EditorDialChevron" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource PaneBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The size input (v1.19.69): the split is finished - the number is
             an HONEST text box now. It types, Enter applies, Escape reverts,
             and no click anywhere in it can ever open the dropdown; the
             caret button beside it is the one door to the list. -->
        <Style x:Key="EditorSizeBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="1,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The ribbon. It wears the tab band's face - the window surface with
             the shared grain and the bottom fade - so the editor reads as a
             peer of the browser's band, and its mode switches sit exactly
             where the reader asked for them: first browser, then PDF editor,
             then the writing tools. -->
        <!-- MinHeight, not Height (v1.19.73): the ribbon's controls doubled
             and the band grows to hold them. v1.19.74: the floor is a literal
             28, no DynamicResource - TabBandHeight only exists in the 98 theme,
             and on every other floor the lookup comes back empty and WPF hands
             the property NaN. Height reads NaN as Auto and shrugs; MinHeight
             throws, and the app died at startup reading exactly this line.
             The doubled controls set the real height; 28 is only the floor
             the band never dips under, whatever the theme. -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                MinHeight="28">
            <Grid>
                <!-- DynamicResource, not Static: GrainBrushShared lives at MainWindow
                     scope by law (App scope freezes an ImageBrush solid - see
                     MainWindow.Resources), and a UserControl's own parse never sees
                     another window's dictionary. The deferred lookup walks the live
                     tree and finds it once hosted, the same bargain PdfViewer's grain
                     layer strikes; a Static here would crash the app on first paint. -->
                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                        Background="{DynamicResource GrainBrushShared}"/>
                <Border IsHitTestVisible="False" Opacity="{DynamicResource BarShadowOpacity}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.45"/>
                            <GradientStop Color="#59000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- The reader asked for the controls to live in the middle of
                     the band, not pressed against its left edge (v1.19.68). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,0">
                    <!-- The two switches: where the reader goes next. The browser
                         globe and the PDF editor's document, wearing the same
                         glyphs they wear on the main toolbar. -->
                    <Button x:Name="EditorBrowserBtn" Content="&#xE774;" Style="{StaticResource EditorBtn}"
                            Click="EditorBrowserBtn_Click" ToolTip="{DynamicResource Str_TT_EditorBrowser}"/>
                    <Button x:Name="EditorPdfBtn" Content="&#xE8A5;" Style="{StaticResource EditorBtn}"
                            Click="EditorPdfBtn_Click" ToolTip="{DynamicResource Str_TT_EditorPdf}"/>
                    <Rectangle Width="2" Fill="{DynamicResource CardBorderBrush}" Margin="8,12"/>
                    <!-- Font dial: shows the font the caret is wearing right now;
                         choosing one applies it to the selection, or - with the
                         caret resting - to what gets typed next. -->
                    <ToggleButton x:Name="FontBtn" Style="{StaticResource EditorDial}"
                                  MinWidth="260" MaxWidth="340" Click="FontBtn_Click"
                                  ToolTip="{DynamicResource Str_TT_EditorFont}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FontText" Text="Segoe UI" FontSize="24"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Margin="10,0,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </ToggleButton>
                    <!-- The size input (v1.19.69): the split the reader demanded
                         is honest now - the number is a text box that types, and
                         the caret button beside it is the only thing that opens
                         the list. Enter applies to the selection, or - with the
                         caret resting - to what gets typed next; Escape reverts.
                         The old chip was still a button wearing a number, and
                         every click on it read as a dropdown asking to open. -->
                    <TextBox x:Name="SizeBox" Style="{StaticResource EditorSizeBox}"
                             Text="12" Margin="4,0,0,0"
                             ToolTip="{DynamicResource Str_TT_EditorFontSize}"
                             GotFocus="SizeBox_GotFocus" LostFocus="SizeBox_LostFocus"
                             KeyDown="SizeBox_KeyDown"
                             PreviewMouseLeftButtonDown="SizeBox_PreviewMouseDown"/>
                    <Button x:Name="SizeDropBtn" Style="{StaticResource EditorDialChevron}"
                            Content="&#xE70D;" Click="SizeDropBtn_Click" Margin="2,0,0,0"
                            ToolTip="{DynamicResource Str_TT_EditorFontSize}"/>
                    <!-- Size steppers: one step up or down the same ladder the
                         size list offers, on the selection or on what gets typed
                         next - the dials' own bargain, one click at a time. -->
                    <!-- The reader read the pair right-to-left and asked for the
                         increase to sit on the right (v1.19.69) - smaller first,
                         bigger last, the ladder's own direction. -->
                    <Button x:Name="FontShrinkBtn" Content="&#xE8E8;" Style="{StaticResource EditorBtn}"
                            Click="FontShrinkBtn_Click" Margin="6,0,0,0"
                            ToolTip="{DynamicResource Str_TT_EditorFontShrink}"/>
                    <Button x:Name="FontGrowBtn" Content="&#xE8E9;" Style="{StaticResource EditorBtn}"
                            Click="FontGrowBtn_Click"
                            ToolTip="{DynamicResource Str_TT_EditorFontGrow}"/>
                    <Rectangle Width="2" Fill="{DynamicResource CardBorderBrush}" Margin="8,12"/>
                    <!-- The classic four. Letters, not glyphs - the way every
                         writing app has drawn them since forever. -->
                    <ToggleButton x:Name="BoldBtn" Style="{StaticResource EditorToggle}"
                                  Click="BoldBtn_Click" ToolTip="{DynamicResource Str_TT_EditorBold}">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="26" FontFamily="Georgia"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicBtn" Style="{StaticResource EditorToggle}"
                                  Click="ItalicBtn_Click" ToolTip="{DynamicResource Str_TT_EditorItalic}">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="26" FontFamily="Georgia"/>
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineBtn" Style="{StaticResource EditorToggle}"
                                  Click="UnderlineBtn_Click" ToolTip="{DynamicResource Str_TT_EditorUnderline}">
                        <TextBlock Text="U" FontSize="26" FontFamily="Georgia" TextDecorations="Underline"/>
                    </ToggleButton>
                    <ToggleButton x:Name="StrikeBtn" Style="{StaticResource EditorToggle}"
                                  Click="StrikeBtn_Click" ToolTip="{DynamicResource Str_TT_EditorStrike}">
                        <TextBlock Text="S" FontSize="26" FontFamily="Georgia" TextDecorations="Strikethrough"/>
                    </ToggleButton>
                    <Rectangle Width="2" Fill="{DynamicResource CardBorderBrush}" Margin="8,12"/>
                    <!-- The block tools (v1.19.73): three header levels, the
                         bullet, the number, the alpha sub-number and the quote.
                         Every one is a toggle - the same button that dresses a
                         line undresses it again - and every light rides the
                         page's own state report, never a local guess. The H
                         faces are locale-neutral marks like B / I / U / S. -->
                    <ToggleButton x:Name="HeaderBtn" Style="{StaticResource EditorToggle}"
                                  Click="HeaderBtn_Click" ToolTip="{DynamicResource Str_TT_EditorHeader}">
                        <TextBlock Text="&#x48;" FontWeight="Bold" FontSize="26" FontFamily="Georgia"/>
                    </ToggleButton>
                    <ToggleButton x:Name="H1Btn" Style="{StaticResource EditorToggle}"
                                  Click="H1Btn_Click" ToolTip="{DynamicResource Str_TT_EditorHeader1}">
                        <TextBlock Text="&#x48;1" FontWeight="Bold" FontSize="22" FontFamily="Georgia"/>
                    </ToggleButton>
                    <ToggleButton x:Name="H2Btn" Style="{StaticResource EditorToggle}"
                                  Click="H2Btn_Click" ToolTip="{DynamicResource Str_TT_EditorHeader2}">
                        <TextBlock Text="&#x48;2" FontWeight="Bold" FontSize="18" FontFamily="Georgia"/>
                    </ToggleButton>
                    <Rectangle Width="2" Fill="{DynamicResource CardBorderBrush}" Margin="8,12"/>
                    <ToggleButton x:Name="BulletBtn" Style="{StaticResource EditorToggle}"
                                  Click="BulletBtn_Click" ToolTip="{DynamicResource Str_TT_EditorBullet}">
                        <TextBlock Text="&#x2022;" FontSize="34" FontFamily="Georgia"/>
                    </ToggleButton>
                    <ToggleButton x:Name="NumBtn" Style="{StaticResource EditorToggle}"
                                  Click="NumBtn_Click" ToolTip="{DynamicResource Str_TT_EditorNumber}">
                        <TextBlock Text="1." FontWeight="Bold" FontSize="20" FontFamily="Georgia"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SubNumBtn" Style="{StaticResource EditorToggle}"
                                  Click="SubNumBtn_Click" ToolTip="{DynamicResource Str_TT_EditorSubnum}">
                        <TextBlock Text="&#x41;." FontWeight="Bold" FontSize="20" FontFamily="Georgia"/>
                    </ToggleButton>
                    <ToggleButton x:Name="QuoteBtn" Style="{StaticResource EditorToggle}"
                                  Click="QuoteBtn_Click" ToolTip="{DynamicResource Str_TT_EditorQuote}">
                        <TextBlock Text="&#x201C;" FontWeight="Bold" FontSize="34" FontFamily="Georgia"/>
                    </ToggleButton>
                    <Rectangle Width="2" Fill="{DynamicResource CardBorderBrush}" Margin="8,12"/>
                    <!-- Link, footnote, and the behind-text image. -->
                    <Button x:Name="LinkBtn" Content="&#xE71B;" Style="{StaticResource EditorBtn}"
                            Click="LinkBtn_Click" ToolTip="{DynamicResource Str_TT_EditorLink}"/>
                    <Button x:Name="FootnoteBtn" Style="{StaticResource EditorBtn}"
                            Click="FootnoteBtn_Click" ToolTip="{DynamicResource Str_TT_EditorFootnote}">
                        <TextBlock Text="&#x2020;" FontSize="28" FontFamily="Georgia"/>
                    </Button>
                    <Button x:Name="ImageBtn" Content="&#xEB9F;" Style="{StaticResource EditorBtn}"
                            Click="ImageBtn_Click" ToolTip="{DynamicResource Str_TT_EditorImage}"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ── The editor's tab band (v1.19.69) ───────────────────────────────
             The reader asked for the SAME tabs the PDF editor and the browser
             wear, and meant it: this band is the reader's own strip, ported
             anatomy for anatomy - PdfViewer.xaml's TabStripBorder read twice
             and written once. The window-surface face (background + grain +
             bottom fade + the retro join line), the overflow chevron, the
             fresh-tab +, and one ItemsControl over a UniformGrid in a bounded
             host: the same TabMargin/TabPadding/TabCornerRadius tokens, the
             same close chip, the same grain tile, the same retro bevels, the
             same active-tab face with its bold label and accent ring. The
             band shows only when two or more documents are open - a lone
             document never grows a bar, the reader's own law. -->
        <Border Grid.Row="1" x:Name="EditorTabBand" Background="{DynamicResource BackgroundBrush}"
                Height="{DynamicResource TabBandHeight}" Visibility="Collapsed"
                SizeChanged="EditorTabBand_SizeChanged">
            <Grid>
                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                        Background="{DynamicResource GrainBrushShared}"/>
                <Border IsHitTestVisible="False" Opacity="{DynamicResource BarShadowOpacity}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.45"/>
                            <GradientStop Color="#59000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="EditorTabJoinLine" Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource PaneBorderBrush}"
                        Visibility="{DynamicResource RetroTabJoinVisibility}"
                        IsHitTestVisible="False"/>
                <DockPanel LastChildFill="True">
                    <!-- The overflow chevron, first-docked so it sits at the band's
                         right edge above the + button; it lists only the tabs
                         windowed out of the strip (ApplyTabWindow). -->
                    <Button x:Name="EditorTabOverflowBtn" DockPanel.Dock="Right" Visibility="Collapsed"
                            Style="{DynamicResource TabNewButton}"
                            Content="&#xE70D;" FontFamily="{DynamicResource IconFont}" FontSize="9"
                            Width="22" Height="16" Margin="2,0,2,0" VerticalAlignment="Center"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="{DynamicResource Str_TT_TabOverflow}" Click="EditorTabOverflow_Click"/>
                    <!-- The fresh-tab face: the + at the end of the tab row, the way
                         the browser's strip wears it. DynamicResource on the style -
                         TabNewButton lives at MainWindow scope and a UserControl's
                         parse cannot see another tree's dictionary. -->
                    <Button x:Name="EditorTabNewBtn" DockPanel.Dock="Right"
                            Style="{DynamicResource TabNewButton}"
                            Content="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                            Width="24" Height="16" Margin="0,0,2,0" VerticalAlignment="Center"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="{DynamicResource Str_TT_EditorNewTab}" Click="EditorTabNewBtn_Click"/>
                    <!-- No side insets, horizontal scrolling DISABLED (not hidden -
                         hidden measures at infinite width and defeats the
                         UniformGrid), the PDF strip's own plumbing. -->
                    <ScrollViewer x:Name="EditorTabScroll" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                                  FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Left"
                                  UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Grid x:Name="EditorTabStripHost" HorizontalAlignment="Left"
                              UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <ItemsControl x:Name="EditorTabStrip" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStripVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="tabBd" CornerRadius="{DynamicResource TabCornerRadius}" Margin="{DynamicResource TabMargin}" Padding="{DynamicResource TabPadding}"
                                            MinWidth="120" MaxWidth="240"
                                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                                            Cursor="Hand" Background="Transparent"
                                            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PaneEdgeBrush}"
                                            ToolTip="{Binding TabTip}"
                                            MouseDown="EditorTab_MouseDown"
                                            MouseRightButtonUp="EditorTab_RightClick"
                                            PreviewMouseLeftButtonDown="EditorTab_DragDown"
                                            PreviewMouseMove="EditorTab_DragMove"
                                            PreviewMouseLeftButtonUp="EditorTab_DragUp">
                                        <Grid>
                                            <Border x:Name="tabGrain" IsHitTestVisible="False"
                                                    CornerRadius="{DynamicResource TabCornerRadius}" Margin="-12,-4,-5,-5"
                                                    Background="{DynamicResource GrainTileBrush}" Opacity="0"/>
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="&#xE711;"
                                                        Style="{DynamicResource TabCloseButton}"
                                                        FontFamily="{DynamicResource IconFont}" FontSize="9"
                                                        Width="16" Height="16" Margin="6,0,0,0" Padding="0"
                                                        VerticalAlignment="Center" FocusVisualStyle="{x:Null}"
                                                        ToolTip="{DynamicResource Str_TT_CloseTab}"
                                                        Tag="{Binding}" Click="EditorTabClose_Click"/>
                                                <TextBlock x:Name="tabLbl" Text="{Binding TabLabel}"
                                                           FontFamily="{DynamicResource UiFont}" FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Border x:Name="tabActiveRetroOuterOutline" IsHitTestVisible="False" Panel.ZIndex="3"
                                                    Margin="{DynamicResource TabActiveOuterOutlineMargin}"
                                                    BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1,1,1,0"
                                                    SnapsToDevicePixels="True" Visibility="Collapsed"/>
                                            <Border x:Name="tabBevelLight" IsHitTestVisible="False" Panel.ZIndex="4"
                                                    Margin="{DynamicResource TabBevelMargin}" SnapsToDevicePixels="True"
                                                    BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                            <Border x:Name="tabBevelDark" IsHitTestVisible="False" Panel.ZIndex="4"
                                                    Margin="{DynamicResource TabBevelMargin}" SnapsToDevicePixels="True"
                                                    BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource TabInactiveBevelDarkThickness}"/>
                                            <Border x:Name="tabActiveRetroInnerBevel" IsHitTestVisible="False" Panel.ZIndex="6"
                                                    Margin="{DynamicResource TabActiveInnerBevelMargin}"
                                                    BorderBrush="{DynamicResource TabActiveInnerBevelBrush}"
                                                    BorderThickness="{DynamicResource TabActiveInnerBevelThickness}"
                                                    SnapsToDevicePixels="True" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Last tab drops its right divider; declared BEFORE the
                                             active trigger so the accent stripe wins when the last
                                             tab is also the active one. -->
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter TargetName="tabBd" Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFirst}" Value="True"/>
                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabInactiveFirstMargin}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsLast}" Value="True"/>
                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabInactiveLastMargin}"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource BgCanvas}"/>
                                            <Setter TargetName="tabGrain" Property="Opacity" Value="{DynamicResource GrainOpacity}"/>
                                            <Setter TargetName="tabBd" Property="BorderThickness" Value="{DynamicResource TabStripeThickness}"/>
                                            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveMargin}"/>
                                            <Setter TargetName="tabBd" Property="Padding" Value="{DynamicResource TabActivePadding}"/>
                                            <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource TabActiveRingBrush}"/>
                                            <Setter TargetName="tabBd" Property="Effect" Value="{DynamicResource BarShadowEffect}"/>
                                            <Setter TargetName="tabLbl" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter TargetName="tabLbl" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="tabLbl" Property="FontSize" Value="11.5"/>
                                            <Setter TargetName="tabBevelDark" Property="BorderThickness" Value="{DynamicResource TabActiveBevelDarkThickness}"/>
                                            <Setter TargetName="tabBevelDark" Property="Margin" Value="{DynamicResource TabActiveBevelDarkMargin}"/>
                                            <Setter TargetName="tabActiveRetroOuterOutline" Property="Visibility" Value="{DynamicResource RetroActiveTabOutlineVisibility}"/>
                                            <Setter TargetName="tabActiveRetroInnerBevel" Property="Visibility" Value="{DynamicResource RetroActiveTabOutlineVisibility}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UseRetroTabChrome}" Value="True">
                                            <Setter TargetName="tabBd" Property="Effect" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding UseRetroTabChrome}" Value="True"/>
                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding UseRetroTabChrome}" Value="True"/>
                                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                                <Condition Binding="{Binding IsFirst}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveFirstMargin}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                                <Condition Binding="{Binding IsLast}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveLastMargin}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                                <Condition Binding="{Binding IsFirst}" Value="True"/>
                                                <Condition Binding="{Binding IsLast}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="tabBd" Property="Margin" Value="{DynamicResource TabActiveOnlyMargin}"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
        <!-- The card: the PDF card's own anatomy - shadow caster, BgCanvas face,
             pane ring, RadCard corners - so the editor reads as the document
             surface it is replacing, in the exact same footprint. The -1 top
             margin is the same tuck the browser's card takes under its band. -->
        <!-- The reader's eight points of air (v1.19.68) while no strip is
             showing; with two or more tabs the band shows and the card tucks
             -1 under it, the PDF editor's own join. RebuildTabStrip owns the
             margin, the same law the reader's CardRow obeys. -->
        <Grid Grid.Row="2" x:Name="CardRow" Margin="0,8,0,0">
            <Border IsHitTestVisible="False" Margin="0,1,0,0"
                    Background="{DynamicResource BgCanvas}"
                    CornerRadius="{DynamicResource RadCard}"
                    Effect="{DynamicResource PaneShadowEffect}"/>
            <Border Panel.ZIndex="6"
                    Background="{DynamicResource BgCanvas}"
                    BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadCard}"
                    ClipToBounds="True">
                <Grid>
                    <Grid x:Name="WebHost" Background="{DynamicResource BgCanvas}"/>
                    <!-- The engine veil: the reader-facing face while WebView2
                         wakes up, and the honest message if the runtime is not
                         there. Hidden the moment the editor document is live. -->
                    <Border x:Name="EngineVeil" Background="{DynamicResource BgCanvas}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="EngineStatus" FontSize="12"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" MaxWidth="340"
                                       TextAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- The two dials' popups live at the control's root so their placement
             targets never leave the ribbon. -->
        <Popup x:Name="FontPopup" PlacementTarget="{Binding ElementName=FontBtn}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource EditorPopupBorder}" Width="300">
                <ListBox x:Name="FontList" BorderThickness="0" Background="Transparent"
                         MaxHeight="460" VirtualizingPanel.IsVirtualizing="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="FontList_SelectionChanged"/>
            </Border>
        </Popup>
        <Popup x:Name="SizePopup" PlacementTarget="{Binding ElementName=SizeDropBtn}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource EditorPopupBorder}" Width="110">
                <ListBox x:Name="SizeList" BorderThickness="0" Background="Transparent"
                         MaxHeight="460" VirtualizingPanel.IsVirtualizing="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="SizeList_SelectionChanged"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
