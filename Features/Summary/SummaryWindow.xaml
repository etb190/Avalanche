<!-- Features/Summary/SummaryWindow.xaml — floating page-summary companion window.
     The rounded chrome, title bar, fade-close and Escape handling come from
     DialogChrome.Frame (composed in code-behind); this file is the card body:
     a range bar with Start/Reset, a segmented depth control, the digest, and
     a status line - all in the house button language (rounded hover wash). -->
<Window x:Class="Avalanche.Features.Summary.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ai="clr-namespace:Avalanche.Features.AI"
        Width="480" Height="660" MinWidth="380" MinHeight="420"
        Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Range boxes: quiet pane face with themed border, not the raw system look. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Text ghost button (Reset): quiet bordered label that fills on hover. -->
        <Style x:Key="SumGhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action: the theme's fixed accent face with a white label. -->
        <Style x:Key="SumPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InstallBtnBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented depth control: compact / standard / deep as connected radio chips,
             replacing the raw system ComboBox. -->
        <Style x:Key="SumDepthSeg" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource SelectionFg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="BodyRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: page range + Reset + Start -->
        <DockPanel Grid.Row="0" Margin="14,12,14,4" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ResetBtn" Style="{StaticResource SumGhostBtn}" VerticalAlignment="Center"/>
                <Button x:Name="GoBtn" Style="{StaticResource SumPrimaryBtn}" Margin="8,0,0,0"
                        VerticalAlignment="Center" MinWidth="96"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock x:Name="PagesLabel" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontFamily="{DynamicResource UiFont}" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBox x:Name="FromBox" Width="46"/>
                <TextBlock x:Name="ToLabel" VerticalAlignment="Center" Margin="6,0"
                           FontFamily="{DynamicResource UiFont}" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBox x:Name="ToBox" Width="46"/>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: depth as a segmented control -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,4,14,2">
            <RadioButton x:Name="DepthCompactBtn" Style="{StaticResource SumDepthSeg}" GroupName="SumDepth"/>
            <RadioButton x:Name="DepthStandardBtn" Style="{StaticResource SumDepthSeg}" GroupName="SumDepth"/>
            <RadioButton x:Name="DepthDeepBtn" Style="{StaticResource SumDepthSeg}" GroupName="SumDepth"/>
        </StackPanel>

        <!-- Row 2: the digest -->
        <Grid Grid.Row="2" Margin="14,6,14,2">
            <RichTextBox x:Name="DocBox" ai:AiMarkdown.Text=""
                         IsReadOnly="True" IsDocumentEnabled="False"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource UiFont}" FontSize="13"
                         Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="OverlayText" Visibility="Collapsed" TextWrapping="Wrap"
                       TextAlignment="Center" FontSize="12" Margin="24,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid>

        <!-- Row 3: status line - progress while generating, word/character counts after -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="14,4,14,12" VerticalAlignment="Center"
                   FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
</Window>
