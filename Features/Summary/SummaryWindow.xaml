<!-- Features/Summary/SummaryWindow.xaml — floating page-summary companion.
     The rounded chrome, title bar, fade-close and Escape handling come from
     DialogChrome.Frame (composed in code-behind); this file is the card body:
     a reading navigator - a start-page stepper up top, a row of range chips
     with word-limit and summary-language dropdowns, the justified digest,
     and a status line - all in the house button language (rounded hover wash). -->
<Window x:Class="Avalanche.Features.Summary.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ai="clr-namespace:Avalanche.Features.AI"
        Width="560" Height="660" MinWidth="460" MinHeight="420"
        Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- DarkComboBox + DarkComboItem live in the shared picker dictionary (the
                     same window-scope merge FileDialog.xaml uses); their brushes resolve
                     from the app theme, so dark/98SE/... follow automatically. -->
                <ResourceDictionary Source="pack://application:,,,/Controls/PickerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Stepper arrows: repeat-press icon buttons that nudge the start page. -->
            <Style x:Key="SumNavBtn" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="face" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    ToolTip="{TemplateBinding ToolTip}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Start-page field: small dark entry, centered digits, accent focus ring. -->
            <Style x:Key="SumPageBox" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBg}"/>
                <Setter Property="SelectionTextBrush" Value="{DynamicResource SelectionFg}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="58"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="0,1,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource SelectionFg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Range chip: quiet at rest, accent face when its range is the active one.
                 Checked is declared after hover so the active chip keeps its state face. -->
            <Style x:Key="SumRangeChip" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="MinWidth" Value="38"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="face" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                    <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource SelectionFg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="BodyRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: live range hint (left) + the start-page stepper (middle). -->
        <Grid Grid.Row="0" Margin="14,12,14,4">
            <TextBlock x:Name="PagesLabel" HorizontalAlignment="Left" VerticalAlignment="Center"
                       MaxWidth="150" TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource UiFont}" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <RepeatButton x:Name="NavPrevBtn" Style="{StaticResource SumNavBtn}"
                              ToolTip="{DynamicResource Str_SummaryPrevPage}">
                    <TextBlock Text="&#xE76B;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TextBrush}" Margin="0,-2,0,0"/>
                </RepeatButton>
                <TextBox x:Name="StartBox" Style="{StaticResource SumPageBox}" Margin="8,0"
                         MaxLength="5" InputScope="Number"
                         ToolTip="{DynamicResource Str_SummaryStartPage}"/>
                <RepeatButton x:Name="NavNextBtn" Style="{StaticResource SumNavBtn}"
                              ToolTip="{DynamicResource Str_SummaryNextPage}">
                    <TextBlock Text="&#xE76C;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TextBrush}" Margin="0,-2,0,0"/>
                </RepeatButton>
            </StackPanel>
        </Grid>

        <!-- Row 1: range chips (a click generates [start, start+N] at once), then the
             word ceiling and the summary language; on narrow windows the dropdowns
             wrap to a second line instead of squeezing. -->
        <WrapPanel Grid.Row="1" Margin="14,4,14,2" VerticalAlignment="Center">
            <StackPanel x:Name="RangePanel" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RangeChip1" Style="{StaticResource SumRangeChip}" Tag="1"/>
                <RadioButton x:Name="RangeChip5" Style="{StaticResource SumRangeChip}" Tag="5"/>
                <RadioButton x:Name="RangeChip20" Style="{StaticResource SumRangeChip}" Tag="20"/>
                <RadioButton x:Name="RangeChip40" Style="{StaticResource SumRangeChip}" Tag="40"/>
                <RadioButton x:Name="RangeChip60" Style="{StaticResource SumRangeChip}" Tag="60"/>
            </StackPanel>
            <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}"
                    Margin="9,0,5,0" VerticalAlignment="Center" Opacity="0.7"/>
            <ComboBox x:Name="WordsCombo" Style="{StaticResource DarkComboBox}" Width="90"
                      Margin="0,0,8,0" VerticalAlignment="Center" MaxDropDownHeight="260"
                      ToolTip="{DynamicResource Str_SummaryWordsTT}"/>
            <ComboBox x:Name="LangCombo" Style="{StaticResource DarkComboBox}" Width="112"
                      VerticalAlignment="Center" MaxDropDownHeight="260"
                      ToolTip="{DynamicResource Str_SummaryLangTT}"/>
        </WrapPanel>

        <!-- Row 2: the digest - justified like a typeset page (Arabic mirrors RTL). -->
        <Grid Grid.Row="2" Margin="14,6,14,2">
            <RichTextBox x:Name="DocBox" ai:AiMarkdown.Text=""
                         ai:AiMarkdown.ParagraphAlignment="Justify"
                         IsReadOnly="True" IsDocumentEnabled="False"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource UiFont}" FontSize="13"
                         Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="OverlayText" Visibility="Collapsed" TextWrapping="Wrap"
                       TextAlignment="Center" FontSize="12" Margin="24,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid>

        <!-- Row 3: status line - progress while generating, word/character counts after -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="14,4,14,12" VerticalAlignment="Center"
                   FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
</Window>
