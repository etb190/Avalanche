<!-- Features/Summary/WebSummaryWindow.xaml — the web page summarizer (v1.19.87).
     The page navigator's replica, stripped to what a web page needs: Start and
     Reset, one prompt dropdown (the web voices), the word ceiling and the
     output language beside it, the digest card with its empty state, and the
     bottom line that names the model, the word and character counts and the
     time the generation took. No range, no recap, no ping, no buffer arrows,
     no tester, no pages picker. The rounded chrome, title bar, fade-close and
     Escape handling come from DialogChrome.Frame (composed in code-behind). -->
<Window x:Class="Avalanche.Features.Summary.WebSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ai="clr-namespace:Avalanche.Features.AI"
        xmlns:ctrl="clr-namespace:Avalanche.Controls"
        Width="560" Height="630" MinWidth="460" MinHeight="390"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- DarkComboBox + DarkComboItem live in the shared picker dictionary;
                     their brushes resolve from the app theme, so dark/98SE/... follow. -->
                <ResourceDictionary Source="pack://application:,,,/Controls/PickerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Start and Reset: full-width faces, the ONLY controls that may begin
                 or end a generation. Green to begin, blue to return to square one. -->
            <Style x:Key="WebSumActionBtn" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    ToolTip="{TemplateBinding ToolTip}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="face" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Title-bar chips (digest font up/down): 24px squares matching the close
                 mark's overridden size. The bar's DragMove must not eat their clicks, so
                 code-behind takes them in the tunnel (PreviewMouseLeftButtonDown). -->
            <Style x:Key="WebSumTitleBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The close chip wears the family face but reads as THE close mark:
                 its X is the theme's danger red at rest, and hover/press paint the
                 face red with the mark in the on-primary color. -->
            <Style x:Key="WebSumCloseBtn" TargetType="Button" BasedOn="{StaticResource WebSumTitleBtn}">
                <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="BodyRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Start and Reset, full width - green to begin, blue to clear. -->
        <Grid Grid.Row="0" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartBtn" Grid.Column="0" Style="{StaticResource WebSumActionBtn}"
                    Background="#FF1B5E20" BorderBrush="#FF0F3D14"
                    Content="{DynamicResource Str_SummaryStart}"
                    ToolTip="{DynamicResource Str_SummaryGo}"/>
            <Button x:Name="ResetBtn" Grid.Column="2" Style="{StaticResource WebSumActionBtn}"
                    Background="#FF0D47A1" BorderBrush="#FF08306B"
                    Content="{DynamicResource Str_SummaryReset}"
                    ToolTip="{DynamicResource Str_SummaryReset}"/>
        </Grid>

        <!-- Row 1: the reader's three dials - the prompt voice, the word
             ceiling and the output language. Each remembers its pick across
             sessions (websummary.* settings), the same memory the book
             navigator's own dials keep. -->
        <WrapPanel Grid.Row="1" Margin="14,8,14,2" VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <ComboBox x:Name="PromptCombo" Style="{StaticResource DarkComboBox}" Width="170" Height="28"
                      VerticalAlignment="Center" MaxDropDownHeight="260"
                      ToolTip="{DynamicResource Str_SummaryGenreTT}"/>
            <ComboBox x:Name="WordsCombo" Style="{StaticResource DarkComboBox}" Width="90" Height="28"
                      Margin="8,0,0,0" VerticalAlignment="Center" MaxDropDownHeight="260"
                      ToolTip="{DynamicResource Str_SummaryWordsTT}"/>
            <ComboBox x:Name="LangCombo" Style="{StaticResource DarkComboBox}" Width="112" Height="28"
                      Margin="8,0,0,0" VerticalAlignment="Center" MaxDropDownHeight="260"
                      ToolTip="{DynamicResource Str_SummaryLangTT}"/>
        </WrapPanel>

        <!-- Row 2: the digest - justified like a typeset page. -->
        <Grid Grid.Row="2" Margin="14,6,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RichTextBox x:Name="DocBox" Grid.Column="0" ai:AiMarkdown.Text=""
                         ai:AiMarkdown.ParagraphAlignment="Justify"
                         IsReadOnly="True" IsDocumentEnabled="False"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource UiFont}" FontSize="13"
                         Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="OverlayText" Grid.Column="0" Visibility="Collapsed" TextWrapping="Wrap"
                       TextAlignment="Center" FontSize="12" Margin="24,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <!-- The digest area's voice: the robot, a title and a nudge while the
                 card holds nothing; three pulsing dots while a run generates. -->
            <StackPanel x:Name="EmptyState" Grid.Column="0" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ctrl:RobotIcon x:Name="EmptyRobot" Width="42" Height="42" HorizontalAlignment="Center"
                                Opacity="0.8" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="EmptyTitle" Text="{DynamicResource Str_SummaryEmptyTitle}" Margin="0,12,0,0"
                           FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptySubtitle" Text="{DynamicResource Str_SummaryEmptySubtitle}" Margin="0,5,0,0"
                           FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="270" LineHeight="16"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <StackPanel x:Name="BusyDots" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Visibility="Collapsed">
                    <Ellipse x:Name="BusyDot1" Width="7" Height="7" Margin="3,0" Opacity="0.25" Fill="{DynamicResource MutedTextBrush}"/>
                    <Ellipse x:Name="BusyDot2" Width="7" Height="7" Margin="3,0" Opacity="0.25" Fill="{DynamicResource MutedTextBrush}"/>
                    <Ellipse x:Name="BusyDot3" Width="7" Height="7" Margin="3,0" Opacity="0.25" Fill="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Row 3: hairline separating the status line from the digest. -->
        <Rectangle Grid.Row="3" Height="1" Fill="{DynamicResource CardBorderBrush}"
                   Margin="14,5,14,0" Opacity="0.85"/>

        <!-- Row 4: status line - words, characters and the generation's own wall
             clock at the left; the model that wrote the digest at the right. -->
        <Grid Grid.Row="4" Margin="14,4,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center"
                       FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Grid.Column="1" x:Name="ModelText" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       MaxWidth="240" HorizontalAlignment="Right"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid>
    </Grid>
</Window>
