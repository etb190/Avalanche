<!-- Features/Summary/RecapWindow.xaml — the Recap companion's body.
     The chrome (rounded card, themed title bar, close chip, corner resize
     grips, pop entrance, Escape-close) is composed in code-behind from
     DialogChrome, exactly like the summary navigator's. This file is the
     card body - and it is deliberately EMPTY of everything but the reading:
     no range chips, no word ceilings, no steppers, no reset. One quiet
     PaneBrush card, one paragraph of 3-4 sentences, a loading line while the
     condensation runs, and a smooth scrollbar when a long paragraph needs it. -->
<Window x:Class="Avalanche.Features.Summary.RecapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ai="clr-namespace:Avalanche.Features.AI"
        Width="420" Height="300" MinWidth="320" MinHeight="200"
        Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <!-- The close chip: the navigator's own family face - danger red mark
             at rest, red face with the on-primary mark on hover - so the
             recap's close mark reads as the same species beside the same
             chrome. (Window-scoped, like every shared face here.) -->
        <Style x:Key="RecapCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="BodyRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The reading surface: a quiet PaneBrush card with a hairline border,
             inset from the window card like the navigator's digest. The recap
             paragraph renders through AiMarkdown (the same reader as the
             digest - headings if the model emits any, otherwise clean prose),
             justified, with the 1.6x line rhythm applied after every paint. -->
        <Border Grid.Row="0" Margin="14,12,14,14" Background="{DynamicResource PaneBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid Margin="12,10,12,10">
                <RichTextBox x:Name="DocBox" ai:AiMarkdown.Text=""
                             ai:AiMarkdown.ParagraphAlignment="Justify"
                             IsReadOnly="True" IsDocumentEnabled="False"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource UiFont}" FontSize="13.5"
                             Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="OverlayText" Visibility="Visible" TextWrapping="Wrap"
                           TextAlignment="Center" FontSize="12.5" Margin="12,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
