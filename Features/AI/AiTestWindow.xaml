<!-- Features/AI/AiTestWindow.xaml — the AI context & verification test companion.
     The chrome (rounded card, themed title bar, close chip, corner resize grips,
     pop entrance, Escape-close) is composed in code-behind from DialogChrome, exactly
     like the summary navigator's. This file is the card body: the header (what model,
     what document), the probe controls (range-span chips + Run), and the
     results card - the color-coded verdict banner, the token audit grid and the
     boundary verification rows (expected vs. recalled sentences) - all in the house
     brush and button language. -->
<Window x:Class="Avalanche.Features.AI.AiTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="720" MinWidth="500" MinHeight="460"
        Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Range chip: the summary navigator's chip face (quiet at rest, accent face
             when its span is the active one). Window-scoped by design, same as there. -->
        <Style x:Key="TestRangeChip" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource SelectionFg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Run and Cancel: the SumActionBtn face (instance-colored; hover and press
             dim the face so the white text keeps its contrast). -->
        <Style x:Key="TestActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar chip: 24px square matching the close mark's overridden size
             (the summary navigator's title-chip face). -->
        <Style x:Key="TestTitleBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The close chip: danger red at rest, red face with the on-primary mark on
             hover - the Windows close convention, in the theme's own palette. -->
        <Style x:Key="TestCloseBtn" TargetType="Button" BasedOn="{StaticResource TestTitleBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The mode switch: an iOS-style sliding toggle. The 16px thumb glides
             along a 40px track in 150ms - accent track when custom range is on,
             quiet track when the preset chips are showing. -->
        <Style x:Key="TestModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="track" CornerRadius="11"
                                    Background="{DynamicResource RowHoverBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource SelectionFg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource SelectionBg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumb"
                                                             Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumb"
                                                             Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom range field: the same bordered face as the chips, centered digits. -->
        <Style x:Key="TestRangeBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          HorizontalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource SelectionFg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="BodyRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: header - the test's identity line: what model, what document. -->
        <StackPanel Grid.Row="0" Margin="16,14,16,0">
            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{DynamicResource Str_AiTest_Title}"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <TextBlock FontSize="12" VerticalAlignment="Center"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{DynamicResource Str_AiTest_Model}"/>
                <TextBlock x:Name="ModelValue" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                           VerticalAlignment="Center" FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource TextBrush}"/>
                <Border Width="1" Height="14" Background="{DynamicResource CardBorderBrush}"
                        Margin="12,0" VerticalAlignment="Center" Opacity="0.7"/>
                <TextBlock FontSize="12" VerticalAlignment="Center"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{DynamicResource Str_AiTest_Document}"/>
                <TextBlock x:Name="DocValue" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                           VerticalAlignment="Center" MaxWidth="360"
                           TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Row 1: the probe controls - the mode switch, then the span chips or
             the custom range field, then Run. Span mode reshare the summary
             navigator's localized span labels (20p/60p/100p); the fourth chip is
             the whole document. Range mode probes exactly the page stretch the
             field names, one [start]-[end] pair. -->
        <WrapPanel Grid.Row="1" Margin="16,10,16,2" HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ModePagesLabel" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,7,0"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{DynamicResource Str_AiTest_ModePages}"/>
                <ToggleButton x:Name="RangeToggle" Style="{StaticResource TestModeToggle}"
                              Margin="0,0,7,0" VerticalAlignment="Center"
                              ToolTip="{DynamicResource Str_AiTest_CustomRange}"/>
                <TextBlock x:Name="ModeRangeLabel" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{DynamicResource Str_AiTest_ModeRange}"/>
                <StackPanel x:Name="RangePanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="Chip20" Style="{StaticResource TestRangeChip}" Tag="20"/>
                    <RadioButton x:Name="Chip60" Style="{StaticResource TestRangeChip}" Tag="60"/>
                    <RadioButton x:Name="Chip100" Style="{StaticResource TestRangeChip}" Tag="100" IsChecked="True"/>
                    <RadioButton x:Name="ChipAll" Style="{StaticResource TestRangeChip}" Tag="-1"/>
                </StackPanel>
                <StackPanel x:Name="RangeInputPanel" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBox x:Name="RangeBox" Style="{StaticResource TestRangeBox}" Width="112"
                             ToolTip="{DynamicResource Str_AiTest_CustomRange}"/>
                </StackPanel>
            </StackPanel>
            <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}"
                    Margin="9,0" VerticalAlignment="Center" Opacity="0.7"/>
            <Button x:Name="RunBtn" Style="{StaticResource TestActionBtn}"
                    Background="#FF1B5E20" BorderBrush="#FF0F3D14"
                    Content="{DynamicResource Str_AiTest_Run}" MinWidth="96"
                    Padding="12,0" Margin="0,0,8,0"
                    ToolTip="{DynamicResource Str_TT_AiTest}"/>
        </WrapPanel>

        <!-- Row 2: the results card, top to bottom: the verdict banner (color-coded,
             hidden until a probe completes), the token audit grid, and the boundary
             verification rows - the sentences the model must recall against the ones
             extracted straight from the PDF. -->
        <ScrollViewer Grid.Row="2" Margin="16,8,16,4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="VerdictBanner" CornerRadius="6" Padding="14,11"
                        Margin="0,2,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="VerdictText" FontSize="15" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               FontFamily="{DynamicResource UiFont}" Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,10">
                    <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource PaneBrush}" Padding="12,9"
                            Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{DynamicResource Str_AiTest_TokensRead}"/>
                            <TextBlock x:Name="TokensReadValue" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,3,0,0" FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource TextBrush}" Text="—"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource PaneBrush}" Padding="12,9"
                            Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{DynamicResource Str_AiTest_TokensSent}"/>
                            <TextBlock x:Name="TokensSentValue" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,3,0,0" FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource TextBrush}" Text="—"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource PaneBrush}" Padding="12,9"
                            Margin="0,5,5,0">
                        <StackPanel>
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{DynamicResource Str_AiTest_CharsSent}"/>
                            <TextBlock x:Name="CharsSentValue" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,3,0,0" FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource TextBrush}" Text="—"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource PaneBrush}" Padding="12,9"
                            Margin="5,5,0,0">
                        <StackPanel>
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{DynamicResource Str_AiTest_Speed}"/>
                            <TextBlock x:Name="SpeedValue" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,3,0,0" FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource TextBrush}" Text="—"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,7"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{DynamicResource Str_AiTest_Boundary}"/>

                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource PaneBrush}" Padding="11,8" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock FontSize="11"
                                   FontFamily="{DynamicResource UiFont}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{DynamicResource Str_AiTest_FirstExpected}"/>
                        <TextBlock x:Name="FirstExpectedValue" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" FontFamily="{DynamicResource UiFont}"
                                   Foreground="{DynamicResource TextBrush}" Text="—"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource PaneBrush}" Padding="11,8" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Grid.Column="0" FontSize="11"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{DynamicResource Str_AiTest_FirstRecalled}"/>
                            <TextBlock x:Name="FirstMatchValue" Grid.Column="1" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}" Text=""/>
                        </Grid>
                        <TextBlock x:Name="FirstRecalledValue" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" FontFamily="{DynamicResource UiFont}"
                                   Foreground="{DynamicResource TextBrush}" Text="—"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource PaneBrush}" Padding="11,8" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock FontSize="11"
                                   FontFamily="{DynamicResource UiFont}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{DynamicResource Str_AiTest_LastExpected}"/>
                        <TextBlock x:Name="LastExpectedValue" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" FontFamily="{DynamicResource UiFont}"
                                   Foreground="{DynamicResource TextBrush}" Text="—"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource PaneBrush}" Padding="11,8" Margin="0,0,0,2">
                    <StackPanel>
                        <Grid>
                            <TextBlock Grid.Column="0" FontSize="11"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{DynamicResource Str_AiTest_LastRecalled}"/>
                            <TextBlock x:Name="LastMatchValue" Grid.Column="1" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{DynamicResource MutedTextBrush}" Text=""/>
                        </Grid>
                        <TextBlock x:Name="LastRecalledValue" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" FontFamily="{DynamicResource UiFont}"
                                   Foreground="{DynamicResource TextBrush}" Text="—"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 3: status line under a hairline, same shape as the summary's. -->
        <StackPanel Grid.Row="3" Margin="16,2,16,12">
            <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}"
                       Margin="0,0,0,6" Opacity="0.85"/>
            <TextBlock x:Name="StatusText" FontSize="11" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
